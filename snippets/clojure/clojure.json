{
  "Comment Block": {
    "prefix": "cb",
    "body": [
      ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;",
      ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; $1 ;;;;;;;;;;;;;;;;;;;;;;;;;;",
      ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
    ]
  },
  "Comment Line": {
    "prefix": "cl",
    "body": ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; $1 ;;;;;;;;;;;;;;;;;;;;;;;;;;"
  },
  "Comment": {
    "prefix": "cc",
    "body": ["(comment", "\t${1}", "\t;", "\t)"]
  },
  "Print": {
    "prefix": "pp",
    "body": "(print $1)"
  },
  "Print Line": {
    "prefix": "pl",
    "body": "(println $1)"
  },
  "Print TODO": {
    "prefix": "ptodo",
    "body": "(println \"TODO: Implement me\")"
  },
  "Print within Thread Operation": {
    "prefix": "pt",
    "body": "((fn [output] (println output) output)) ; TODO: Remove me"
  },
  "Print within Let": {
    "prefix": "pl",
    "body": "_ (println $1); TODO: Remove me"
  },
  "Let": {
    "prefix": "l",
    "body": ["(let [${1:binding} ${2:value}", "\t\t\t;", "\t\t\t]", "\t${3})"]
  },
  "Def": {
    "prefix": "d",
    "body": "(def ${1:name} ${2:value})"
  },
  "Def Function": {
    "prefix": "df",
    "body": ["(defn ${1:name} ${2:doc-string?}", "\t[${3}]", "\t${4})"]
  },
  "Defn Function (Async)": {
    "prefix": "dfa",
    "body": ["(defn ^:async ${1:name} ${2:doc-string?}", "\t[${3}]", "\t${4})"]
  },
  "Def Macro": {
    "prefix": "dm",
    "body": ["(defmacro ${1:name} ${2:doc-string?}", "\t[${3}]", "\t${4})"]
  },
  "Function": {
    "prefix": "f",
    "body": "(fn ${1:name?} [${2}] ${3})"
  },
  "Function (Async)": {
    "prefix": "fa",
    "body": "(^:async fn ${1:name?} [${2}] ${3})"
  },
  "Function Testing (Async)": {
    "prefix": "fat",
    "body": "((^:async fn [${1}] (def ${2} (await ${3}))))"
  },
  "Try Catch": {
    "prefix": "tryc",
    "body": ["(try", "\t${1}", "\t(catch Exception e", "\t${2}))"]
  },
  "Try Finally": {
    "prefix": "tryf",
    "body": ["(try", "\t${1}", "\t(finally", "\t\t${3}))"]
  },
  "Try Catch Finally": {
    "prefix": "trycf",
    "body": [
      "(try",
      "\t${1}",
      "\t(catch Exception e",
      "\t\t${2})",
      "\t(finally",
      "\t\t${3}))"
    ]
  },
  "Throw": {
    "prefix": "throw",
    "body": "(throw (Exception. \"${1:message}\"))"
  },
  "For": {
    "prefix": "for",
    "body": ["(for [${1:x} ${2:coll}]", "\t${3})"]
  },
  "Doseq": {
    "prefix": "doseq",
    "body": ["(doseq [${1:x} ${2:coll}]", "\t${3})"]
  },
  "Loop": {
    "prefix": "loop",
    "body": [
      "(loop [${1:binding} ${2:init}]",
      "\t(if ${3:condition}",
      "\t\t${4:result}",
      "\t\t(recur ${5:new-value})))"
    ]
  },
  "Require": {
    "prefix": "req",
    "body": ["(:require", " [${1:namespace} :as ${2:alias}]", " ;", " )"]
  },
  "Import": {
    "prefix": "imp",
    "body": ["(:import", " ${1:class}", " ;", " )"]
  },
  "Def Test": {
    "prefix": "td",
    "body": [
      "(deftest ${1:test-name}",
      "\t(testing \"${2:description}\"",
      "\t\t${3}))"
    ]
  },
  "Test Block": {
    "prefix": "tb",
    "body": ["(testing \"${1:description}\"", "\t${2})"]
  },
  "Test Statement": {
    "prefix": "ts",
    "body": "(is (= ${1:expected} ${2:actual}))"
  }
}
