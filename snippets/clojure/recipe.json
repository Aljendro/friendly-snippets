{
  "Recipe": {
    "prefix": "recipe",
    "body": [
      "#recipe{:title \"$1\"",
      "\t\t\t\t:description \"$2\"",
      "\t\t\t\t:inputs #inputs[$3]",
      "\t\t\t\t:instructions #instructions[$4]}$0"
    ]
  },
  "Input User": {
    "prefix": "rinu",
    "body": "[:inputaction/user {:var \"$1\" :default \"$2\"}]$0"
  },
  "Input Set With": {
    "prefix": "rinsw",
    "body": "[:inputaction/set {:var \"$1\" :with \"$2\"}]$0"
  },
  "Input Set From": {
    "prefix": "rinsf",
    "body": "[:inputaction/set {:var \"$1\" :from \"$2\"}]$0"
  },
  "Input AWS Secret": {
    "prefix": "rins",
    "body": "[:inputaction/aws_secret {:var \"$1\" :name \"$2\" :profile \"$3\"}]$0"
  },
  "Instruction Create": {
    "prefix": "rac",
    "body": "[:instructionaction/create {:filepath \"$1\" :template \"<t>/$2.template\"}]$0"
  },
  "Instruction Delete": {
    "prefix": "rad",
    "body": "[:instructionaction/delete {:filepath \"$1\"}]$0"
  },
  "Instruction Update": {
    "prefix": "rau",
    "body": "[:instructionaction/update {:filepath \"$1\" :template \"<t>/$2.template\" :target \"$3\"}]$0"
  },
  "Instruction Nvim": {
    "prefix": "ran",
    "body": "[:instructionaction/nvim {:filepath \"$1\" :commands \"$2\"}]$0"
  }
}
