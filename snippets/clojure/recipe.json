{
  "Recipe": {
    "prefix": "recipe",
    "body": [
      "#recipe{:title \"$1\"",
      "\t\t\t\t:description \"$2\"",
      "\t\t\t\t:inputs #inputs[$3]",
      "\t\t\t\t:instructions #instructions[$4]}$0"
    ]
  },
  "Input User": {
    "prefix": "rinu",
    "body": "[:user {:var \"$1\" :default \"$2\"}]$0"
  },
  "Input Set With": {
    "prefix": "rinsw",
    "body": "[:set {:var \"$1\" :with \"$2\"}]$0"
  },
  "Input Set From": {
    "prefix": "rinsf",
    "body": "[:set {:var \"$1\" :from \"$2\"}]$0"
  },
  "Input AWS Secret": {
    "prefix": "rins",
    "body": "[:aws_secret {:var \"$1\" :name \"$2\" :profile \"$3\"}]$0"
  },
  "Instruction Create": {
    "prefix": "rac",
    "body": "[:create {:filepath \"$1\" :template \"<t>/$2.template\"}]$0"
  },
  "Instruction Directory": {
    "prefix": "rad",
    "body": "[:dir {:filepath \"$1\"}]$0"
  },
  "Instruction Delete": {
    "prefix": "rad",
    "body": "[:delete {:filepath \"$1\"}]$0"
  },
  "Instruction Update": {
    "prefix": "rau",
    "body": "[:update {:filepath \"$1\" :template \"<t>/$2.template\" :target \"$3\"}]$0"
  },
  "Instruction Nvim": {
    "prefix": "ran",
    "body": "[:nvim {:filepath \"$1\" :commands \"$2\"}]$0"
  }
}
